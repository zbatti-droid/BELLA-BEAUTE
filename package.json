{
  "name": "bella-beaute-luxury-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "node --env-file=.env --import tsx server/index.ts",
    "start": "node --import tsx server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "verify": "npm audit --audit-level=high && npm test && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.109.0",
    "@vitejs/plugin-react": "latest",
    "axios": "latest",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "latest",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "latest",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.18.4",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "latest",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "prisma": "^7.10.0",
    "tsx": "latest",
    "typescript": "^7.0.2",
    "vite": "latest",
    "vitest": "^5.0.1"
  }
}
